# Copie este ficheiro para .env e preencha os valores.
# NÃO commitar o .env (contém segredos).

# --- Base de dados PostgreSQL (Neon: https://neon.tech) ---
# DATABASE_URL: ligação usada em runtime pela app — TEM de ser a "Pooled connection"
# da Neon (hostname com "-pooler"), não a direta. Em serverless (Vercel), cada
# invocação abre a sua própria ligação; sem pooling esgota-se o limite da Neon e
# a app começa a devolver 500 de forma intermitente (mesmo com a escrita já feita).
# Ex.: postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGIAO.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connection_limit=1"

# DIRECT_URL: ligação direta (sem pooling) — só usada por `prisma db push`/`migrate`,
# que não funciona de forma fiável através do pooler em modo transaction.
# Ex.: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGIAO.aws.neon.tech/DB?sslmode=require"

# --- Segredo de sessão (assinatura HMAC dos cookies) ---
# Gerar com: openssl rand -base64 32
AUTH_SECRET="troca-me-em-producao"

# --- Distância rodoviária dos orçamentos (OpenRouteService) ---
# Conta grátis em https://openrouteservice.org/dev/#/signup -> "Request a token".
# Sem esta chave o cálculo automático de km fica desativado (introduz-se o km à mão).
ORS_API_KEY=""

# --- Portagens automáticas de camião (TollGuru) ---
# Conta grátis em https://tollguru.com/developers (Dashboard -> API Keys).
# Sem esta chave as portagens usam a tabela por zona (zonaPortagem) como até aqui.
TOLLGURU_API_KEY=""

# --- CORS da API para apps nativas (ex. app Motorista offline, Capacitor) ---
# Origens autorizadas a chamar /api/* por fetch cross-origin (separadas por vírgula).
# O site/páginas nunca precisam disto (mesma origem). Default cobre as origens mais
# comuns de uma WebView Capacitor; ajustar quando a origem real da app for conhecida.
APP_ORIGINS_PERMITIDAS="capacitor://localhost,http://localhost,https://localhost"
