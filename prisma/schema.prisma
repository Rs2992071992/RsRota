// Camada de dados. Provider PostgreSQL (produção, ex.: Neon).
// Para dev local pode-se apontar o DATABASE_URL para um Postgres local ou um branch Neon.
// A lógica de cálculo vive em lib/calc e não depende deste schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime (app): connection pooling da Neon (pgbouncer) — evita esgotar
  // ligações diretas em serverless (Vercel), cada invocação abre a sua própria.
  url       = env("DATABASE_URL")
  // Migrações (`prisma db push`/`migrate`): ligação direta — DDL não passa
  // de forma fiável pelo pooler em modo transaction.
  directUrl = env("DIRECT_URL")
}

/// Parâmetros de custo (§3.4). Singleton: existe sempre uma linha com id = 1.
model Parametros {
  id Int @id @default(1)

  // --- Motorista ---
  salarioMensal    Float @default(1345)
  seguroMensal     Float @default(30)
  percentEncargos  Float @default(0.235) // 23,5% sobre o salário
  alimentacaoDia   Float @default(6.4)
  diasAlimentacao  Float @default(19)
  kmAnuais         Float @default(95000)
  fatorAnualizacao Float @default(14) // 14 salários/ano em Portugal (12 + Natal + férias)

  // --- Veículo ---
  valorAquisicao   Float @default(127000)
  valorResidual    Float @default(88000)
  vidaUtilAnos     Float @default(3)
  iucAnual         Float @default(600)
  taxaJuros        Float @default(0.02) // sobre o valor de aquisição
  seguroAnual      Float @default(4000)
  reparacoesAnuais Float @default(1500)
  revisaoAnual     Float @default(1200)
  inspecaoAnual    Float @default(100)

  // --- Combustível / AdBlue ---
  precoCombRef  Float @default(1.834) // preço de referência (entra no cálculo)
  precoCombReal Float @default(1.834) // preço real médio pago (informativo)
  consumoAdblue Float @default(2.5) // L / 100 km
  precoAdblue   Float @default(0.3) // € / L

  // --- Outros ---
  margemMinima      Float @default(1.25) // preço mínimo = custo × 1,25
  valorHoraExtra    Float @default(8)
  valorNoite        Float @default(70) // € por noite fora (× nº de noites)
  capacidadeCamiao  Float @default(14000)
  capacidadeReboque Float @default(24000)

  // --- Paletes (Paragem.volume = true, Paragem.tipoPalete = PALETE_120X80 |
  // PALETE_120X100) ---
  // Ocupação por nº de paletes, não por peso (uma palete leve ocupa o mesmo
  // "slot" físico) — o peso não entra no registo nem no cálculo para este
  // tipo de carga; o consumo é tratado sempre como se o veículo fosse vazio.
  // Dois pares de capacidade por tipo de palete: "A/B" para quando a
  // paragem tem tipoVeiculo = CAMIAO+REBOQUE (o conjunto todo), "ACamiao/
  // BCamiao" para quando é só CAMIAO (sem reboque) — mesma distinção que já
  // existe para peso em capacidadeCamiao/capacidadeReboque.
  capacidadePaleteA       Float @default(38) // paletes 1.2x0.8x2.7m, camião+reboque
  capacidadePaleteB       Float @default(28) // paletes 1.2x1x2.7m, camião+reboque
  capacidadePaleteACamiao Float @default(18) // paletes 1.2x0.8x2.7m, só camião
  capacidadePaleteBCamiao Float @default(14) // paletes 1.2x1x2.7m, só camião

  atualizadoEm DateTime @updatedAt
}

/// Pneus por eixo (custo por km = custo / km de vida).
/// veiculoId null = pneus "globais" (template/fallback); senão pertencem a um veículo.
model Pneu {
  id    Int    @id @default(autoincrement())
  eixo  String // "1 Eixo", "2 Eixo", ...
  custo Float
  km    Float
  ordem Int    @default(0)

  veiculoId Int?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  @@index([veiculoId])
}

/// Veículo da frota. Cada camião tem os seus próprios custos (acquisição, seguros,
/// manutenção, pneus, capacidades). Os valores por defeito replicam os de `Parametros`.
model Veiculo {
  id        Int     @id @default(autoincrement())
  nome      String
  matricula String?
  ativo     Boolean @default(true)
  // LIGEIRO = só ficha de frota (custo/manutenção/inspeção, sem capacidade de
  // carga nem consumo próprio — nunca aparece nos seletores de veículo de
  // rota/paragem/orçamento/carga). PESADO = camião, comportamento de sempre.
  categoria String  @default("PESADO") // LIGEIRO | PESADO

  valorAquisicao          Float @default(127000)
  valorResidual           Float @default(88000)
  vidaUtilAnos            Float @default(3)
  iucAnual                Float @default(600)
  taxaJuros               Float @default(0.02)
  seguroAnual             Float @default(4000)
  reparacoesAnuais        Float @default(1500)
  revisaoAnual            Float @default(1200)
  inspecaoAnual           Float @default(100)
  capacidadeCamiao        Float @default(14000)
  capacidadeReboque       Float @default(24000)
  capacidadePaleteA       Float @default(38) // camião+reboque
  capacidadePaleteB       Float @default(28) // camião+reboque
  capacidadePaleteACamiao Float @default(18) // só camião
  capacidadePaleteBCamiao Float @default(14) // só camião
  // ⚠️ capacidadePaleteA/B/ACamiao/BCamiao ficam legado a partir de 2026-08-28: só
  // servem para paragens antigas (Paragem.tipoPalete string) recalcularem exatamente
  // como sempre. Paragens novas usam capacidade por dimensão (ver caixaComprimentoMm/
  // LarguraMm + reboqueHabitual abaixo, lib/calc/perStop.ts::capacidadePaleteDimensoes).

  // --- Caixa de carga (mm) — opcional; só preenchido para veículos usados
  // no empacotamento de paletes (ver Carregamento/PedidoPalete) e no rateio por
  // dimensão (ver acima). null = veículo não configurado para esta funcionalidade.
  // Representa sempre "só camião" — a caixa do reboque vem de `reboqueHabitual`.
  caixaComprimentoMm Float?
  caixaLarguraMm     Float?

  // Reboque ao qual este camião está normalmente acoplado (na prática é sempre o
  // mesmo par camião/reboque) — usado para somar a caixa do reboque à do camião
  // quando Paragem.tipoVeiculo = CAMIAO+REBOQUE, no rateio por dimensão. null =
  // este veículo nunca anda com reboque (ou ainda não configurado).
  reboqueHabitualId Int?
  reboqueHabitual   Reboque? @relation(fields: [reboqueHabitualId], references: [id], onDelete: SetNull)

  // Multiplicador de segurança sobre a capacidade geométrica calculada (paletesQueCabem)
  // — 1 = confiar 100% na fórmula de área; < 1 corrige para baixo um veículo/reboque
  // concreto com perdas reais (estrutura, acesso) que a área pura não capta.
  fatorOcupacaoPalete Float @default(1)

  // --- Inspeção periódica — aviso ao motorista ao selecionar o veículo no
  // registo, a partir de 45 dias antes do prazo. `inspecaoVerificada` cala o
  // aviso quando o escritório confirma que já foi feita; reposta a false
  // sempre que o prazo (`dataLimiteInspecao`) muda para uma data diferente.
  dataLimiteInspecao DateTime?
  inspecaoVerificada Boolean   @default(false)

  pneus         Pneu[]
  paragens      Paragem[]
  manutencoes   Manutencao[]
  avarias       Avaria[]
  carregamentos Carregamento[]
  // Tabela de consumo (L/100km por escalão de carga) própria deste veículo —
  // opcional; sem linhas, o cálculo cai na tabela global (TabelaConsumo com
  // veiculoId null, ver abaixo).
  consumoTabela TabelaConsumo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Registo de manutenções/reparações de um veículo. `valor` e `dias` ficam
/// nullable porque a descrição/data são registadas primeiro e o custo/tempo
/// parado só se sabe mais tarde, quando a reparação está feita/orçada.
model Manutencao {
  id        Int      @id @default(autoincrement())
  descricao String
  data      DateTime
  valor     Float?
  dias      Float?

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  criadoEm DateTime @default(now())

  @@index([veiculoId])
}

/// Reporte informal de avaria por um motorista (data + descrição do
/// problema). Deliberadamente separado de Manutencao: essa alimenta o motor
/// de custo do veículo (valor/dias), esta é só sinalização operacional —
/// nunca entra em nenhum cálculo.
model Avaria {
  id          Int      @id @default(autoincrement())
  data        DateTime
  itens       Json // Array<{ id: number; texto: string; resolvido: boolean }>
  observacoes String?

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  reportadoPorId Int?
  reportadoPor   Utilizador? @relation(fields: [reportadoPorId], references: [id])

  resolvida   Boolean   @default(false)
  resolvidaEm DateTime?

  criadoEm DateTime @default(now())

  @@index([veiculoId])
}

/// Tabela de portagens (zona -> valor, classe 4, só de ida).
model TabelaPortagem {
  id    Int    @id @default(autoincrement())
  zona  String @unique
  valor Float
}

/// Curva de consumo por carga (lookup aproximado por escalão inferior).
model TabelaConsumo {
  id        Int      @id @default(autoincrement())
  // null = tabela global (Parâmetros, fallback); preenchido = tabela própria
  // de um veículo (ver Veiculo.consumoTabela) — usada em vez da global
  // sempre que esse veículo tiver pelo menos uma linha.
  veiculoId Int?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: Cascade)

  cargaKg     Float
  consumoL100 Float // litros / 100 km

  @@unique([veiculoId, cargaKg])
}

/// Registo Diário (§3.1) — cada linha é uma paragem.
model Paragem {
  id          Int      @id @default(autoincrement())
  idRota      String
  data        DateTime @default(now())
  tipoViagem  String // "Ida" | "Volta"
  tipoVeiculo String // CAMIAO | CAMIAO+REBOQUE | VAZIO
  cliente     String

  // ⚠️ Legado (paragens registadas antes de 2026-08-28): carga por volume (paletes)
  // em vez de peso. Quando true, tipoPalete identifica o tamanho e nPaletes a
  // quantidade; a capacidade usada no cálculo depende também de tipoVeiculo (camião
  // vs camião+reboque) — ver Parametros/Veiculo.capacidadePaleteA/B/ACamiao/BCamiao.
  // A UI de registo não escreve mais estes 2 campos — só ficam para o motor
  // continuar a recalcular o histórico exatamente como sempre (lib/calc/perStop.ts).
  volume     Boolean @default(false)
  tipoPalete String? // PALETE_120X80 | PALETE_120X100, só relevante se volume=true

  // Palete desta paragem (2026-08-28 em diante — único modo para paragens novas,
  // exceto VAZIO). tipoPaleteId é só referência/label (catálogo TipoPalete, pode
  // mudar de dimensões no futuro); paleteComprimentoMm/LarguraMm são a cópia
  // congelada das dimensões no momento do registo — fonte de verdade do cálculo,
  // imune a edições posteriores do catálogo (mesmo princípio do resto do snapshot).
  tipoPaleteId        Int?
  tipoPaleteRef       TipoPalete? @relation(fields: [tipoPaleteId], references: [id], onDelete: SetNull)
  paleteComprimentoMm Float?
  paleteLarguraMm     Float?

  // Várias linhas de palete na MESMA paragem (2026-09 em diante) — o mesmo
  // cliente, na mesma descarga, com paletes de tamanhos diferentes (ex.: 4×
  // 1300×1100 + 2× 1200×800). Forma: [{ tipoPaleteId, comprimentoMm, larguraMm,
  // nPaletes }], dimensões congeladas no registo (fonte de verdade, como
  // paleteComprimentoMm/LarguraMm acima). null = paragem de linha única — o
  // motor cai nos campos escalares acima (todo o histórico, zero migração).
  // Quando preenchido, os escalares acima ficam com o agregado (nPaletes = Σ,
  // tipoPaleteId/dims = 1.ª linha) só para leitores antigos/exportação.
  paletes Json?

  // Nº de meias-paletes empilhadas em cima das paletes de base desta paragem
  // (nPaletes acima) — não têm dimensões próprias, nunca entram no cálculo
  // de capacidade/espaço (não ocupam uma base própria), só valem metade de
  // uma palete inteira no rateio (lib/calc/perStop.ts).
  nMeiasPaletes Float @default(0)

  // Peso aproximado DESCARREGADO nesta paragem (kg) — opcional, só para alimentar a
  // tabela de consumos (TabelaConsumo); nunca entra no rateio/coeficienteCarga, que
  // é sempre por dimensão de palete. Sem valor -> consumo trata como vazio (0 kg).
  pesoAproximado Float?

  // Peso aproximado RECOLHIDO/carregado nesta paragem (kg) — opcional, 2026-09+.
  // Paragens antigas (RECOLHA pura, registadas antes deste campo existir) guardaram
  // esse valor no campo `pesoAproximado` acima — ver o fallback em
  // lib/calc/perStop.ts::pesoAproximadoDescarregado/pesoAproximadoCarregadoEfetivo
  // (mesma regra de sentido de linhasCargaParagem em lib/calc/cargaRota.ts).
  pesoAproximadoCarregado Float?

  // Motorista que registou a paragem (null em dados importados/antigos).
  motoristaId Int?
  motorista   Utilizador? @relation(fields: [motoristaId], references: [id])

  // Veículo usado nesta paragem (frota partilhada). null em dados antigos -> fallback.
  // Apagar um veículo põe veiculoId a null; o snapshot já congelado preserva os custos.
  veiculoId Int?
  veiculo   Veiculo? @relation(fields: [veiculoId], references: [id], onDelete: SetNull)

  // Snapshot dos custos efetivos (taxas/escalares) congelados no momento do registo.
  // Quando presente, o cálculo usa-o em vez dos parâmetros atuais (histórico estável).
  // Forma: ver ParagemSnapshot em lib/calc/types.ts.
  snapshot Json?

  kmInicial Float
  kmFinal   Float

  kgCarregados    Float @default(0)
  kgDescarregados Float @default(0)
  // Nº de paletes carregadas (só relevante quando volume=true).
  nPaletes        Float @default(0)

  litrosAbastecidos Float @default(0)
  custoAbastecido   Float @default(0) // € realmente pagos no abastecimento

  zonaPortagem   String @default("")
  portagensExtra Float  @default(0)
  noitesFora     Float  @default(0)
  alimentacao    Float  @default(0)
  horasExtra     Float  @default(0)

  // Sinalização simples do motorista: "isto é uma recolha para entregar a
  // outro cliente" — não escolhe o destino (não sabe/não interessa no
  // momento do registo), só assinala para o escritório rever.
  recolha Boolean @default(false)

  // A quem faturar o custo desta paragem em vez do próprio `cliente` — só
  // preenchido pelo escritório (ex.: recolha em "Tec-masterferro" faturada a
  // "Tecfil"). null (default) = fatura normalmente ao próprio cliente,
  // preserva o rateio de toda a história existente.
  faturarCliente String?

  // Só relevante numa paragem MISTA (entrega + recolha) com faturarCliente
  // preenchido. null/false (default) = comportamento de sempre: faturarCliente
  // cobre TUDO (entrega + recolha), preserva o rateio de toda a história
  // existente. true = a entrega fica com o próprio `cliente` (quem a recebeu),
  // só a recolha vai para faturarCliente — para o caso em que a entrega e a
  // recolha no mesmo sítio pertencem a clientes diferentes.
  faturarClienteApenasRecolha Boolean?

  // Atribuição manual do custo deste troço a clientes — só relevante quando
  // tipoVeiculo = VAZIO. Forma: [{ cliente, km }]. Os km atribuídos convertem-se
  // em fração do troço (km/kmFeitos) aplicada ao custoParagem; o que não for
  // coberto continua a diluir-se automaticamente pelos clientes da rota, como
  // sempre foi (ver lib/calc/perRoute.ts::calcularRota). null = sem override,
  // comportamento inalterado. Só o escritório o define (CAMPOS_ESCRITORIO).
  rateioManual Json?

  // Override opcional do preço de referência do combustível para esta paragem.
  precoCombRefOverride Float?

  // Valor a cobrar ao cliente por esta paragem (faturado, editável no escritório).
  // Mantém o nome `receitaPaga` por compatibilidade (calc/import/export/snapshot).
  receitaPaga Float @default(0)

  // Estado de cobrança. Os clientes têm 90 dias (a contar de `data`) para pagar.
  // `pago` = valor encaixado; `dataPagamento` = quando foi marcado pago (informativo).
  // Camada de tesouraria: NÃO entra no cálculo de custo/lucro da rota.
  pago          Boolean   @default(false)
  dataPagamento DateTime?

  // Colunas Espanha — meramente informativas (poupança), nunca entram no custo.
  litrosEspanha Float?
  custoEspanha  Float?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([idRota])
  @@index([data])
  @@index([motoristaId])
  @@index([veiculoId])
}

/// Ficha de contacto de um cliente. Ligada por `nome` ao campo `Paragem.cliente`
/// (sem FK, para não normalizar/arriscar os dados existentes). Apenas guarda dados
/// de contacto — NÃO entra em nenhum cálculo. Criada/editada no menu Clientes.
model Cliente {
  id       Int     @id @default(autoincrement())
  nome     String  @unique // corresponde a Paragem.cliente
  contato  String? // nome da pessoa de contacto
  telefone String?
  email    String?
  morada   String?
  notas    String?

  // A quem cobrar por este cliente (ex.: "Tec-junqueira" -> empresa "Tecfil").
  // Atribuído explicitamente em /escritorio/clientes/empresas — nunca adivinhado
  // em runtime a partir do nome, porque o prefixo informal não é consistente
  // (espaços, erros de escrita).
  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  pedidosPalete PedidoPalete[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Empresa-mãe a quem se cobra um grupo de clientes finais (ex.: Tecfil,
/// Blowtec). Usada para agrupar/subtotalizar Cobranças por empresa.
model Empresa {
  id       Int       @id @default(autoincrement())
  nome     String    @unique
  clientes Cliente[]
  criadoEm DateTime  @default(now())
}

/// Alias de nome de cliente: mapeia uma variante (tal como aparece nas
/// importações/registos) para o nome canónico em `Cliente.nome`. Usado para
/// agrupar histórico disperso por pequenas diferenças de escrita, e para
/// normalizar automaticamente futuras importações (ver /api/clientes/agrupar
/// e /api/importar).
model ClienteAlias {
  id          Int      @id @default(autoincrement())
  alias       String   @unique
  clienteNome String
  criadoEm    DateTime @default(now())

  @@index([clienteNome])
}

/// Orçamento (devis) emitido ao cliente ANTES do transporte. Não entra em nenhum
/// cálculo de rota/rentabilidade — é a camada comercial a montante. Os dados de
/// contacto do cliente são "snapshot" no momento da criação (email/morada), para
/// que um orçamento enviado fique fiel mesmo que a ficha Cliente mude depois.
model Devis {
  id             Int       @id @default(autoincrement())
  numero         String    @unique // ORC-2026-0001
  cliente        String // nome (corresponde a Cliente.nome / Paragem.cliente)
  clienteEmail   String?
  clienteMorada  String?
  clienteContato String?
  data           DateTime  @default(now())
  validade       DateTime? // por defeito data + 30 dias
  estado         String    @default("RASCUNHO") // RASCUNHO | ENVIADO | ACEITE | RECUSADO
  origemPadrao   String? // morada de partida por defeito (base/armazém)

  // Linhas do orçamento (Json) — ver LinhaDevis em lib/calc/orcamento.ts.
  linhas      Json
  observacoes String?

  // Totais congelados (calculados a partir das linhas) para o PDF/histórico.
  ivaPercent Float @default(23) // IVA Portugal (editável por orçamento)
  subtotal   Float @default(0)
  ivaValor   Float @default(0)
  total      Float @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([cliente])
  @@index([estado])
}

/// Utilizadores: escritório (uma linha) e N motoristas, cada um com ID + PIN.
model Utilizador {
  id      Int     @id @default(autoincrement())
  codigo  String  @unique // ID de login (ex.: "joao", "m01"); escritório = "ESCRITORIO"
  nome    String? // nome do motorista (null para escritório)
  perfil  String // "ESCRITORIO" | "MOTORISTA"
  pinHash String

  // Bloqueio por força bruta no PIN (ver POST /api/auth/login): incrementa a
  // cada falha, bloqueia a conta durante BLOQUEIO_MINUTOS ao atingir o limite.
  tentativasFalhadas Int       @default(0)
  bloqueadoAte       DateTime?

  // Parâmetros salariais próprios de cada motorista (defaults = valores atuais §3.4).
  salarioMensal    Float @default(1345)
  seguroMensal     Float @default(30)
  percentEncargos  Float @default(0.235)
  alimentacaoDia   Float @default(6.4)
  diasAlimentacao  Float @default(19)
  kmAnuais         Float @default(95000)
  fatorAnualizacao Float @default(14)

  // Campos opcionais do registo de paragem, visíveis ou não consoante o
  // motorista (alguns nunca fazem noites fora, por exemplo) — controlado
  // pelo escritório em /escritorio/motoristas/[id]. Default true preserva o
  // comportamento atual (todos visíveis) até o escritório desligar algum.
  // Só afeta o formulário do próprio motorista (RegistoForm.tsx); o
  // escritório continua a ver sempre tudo no ParagemEditor.tsx.
  mostraNoitesFora  Boolean @default(true)
  mostraAlimentacao Boolean @default(true)
  mostraHorasExtra  Boolean @default(true)

  paragens Paragem[]
  avarias  Avaria[]

  criadoEm DateTime @default(now())
}

/// Catálogo de tipos de palete (dimensões em mm), editável em Parâmetros.
/// Tabela (não lista fixa no código) porque novos formatos podem ser
/// necessários no futuro sem alteração de código. `ativo=false` esconde o
/// tipo de novos pedidos sem apagar histórico (pedidos já criados mantêm o FK).
model TipoPalete {
  id            Int     @id @default(autoincrement())
  nome          String  @unique // ex.: "1300x1100"
  comprimentoMm Float
  larguraMm     Float
  ativo         Boolean @default(true)
  ordem         Int     @default(0)

  pedidos  PedidoPalete[]
  paragens Paragem[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Catálogo de reboques (atrelados) — equipamento independente e reutilizável,
/// NÃO pertence a um Veiculo fixo: é escolhido por carregamento (ver
/// Carregamento.reboque), já que o mesmo veículo pode usar reboques
/// diferentes consoante a volta. `ativo=false` retira de serviço preservando
/// o histórico dos carregamentos que já o usaram. `veiculosHabituais` é outra
/// relação (rateio por dimensão, ver Veiculo.reboqueHabitual) — regista qual é o
/// par habitual na prática, sem impedir escolher outro reboque num Carregamento.
model Reboque {
  id            Int     @id @default(autoincrement())
  nome          String
  matricula     String?
  comprimentoMm Float
  larguraMm     Float
  ativo         Boolean @default(true)

  carregamentos     Carregamento[]
  veiculosHabituais Veiculo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Sessão de carregamento: agrega os pedidos telefónicos recebidos para UM
/// veículo. Puramente operacional (tracking de espaço/paletes) — NÃO entra em
/// Orçamentos/Cobranças/faturação. Um reboque pode ser anexado a ESTE
/// carregamento específico, escolhido no momento entre os do catálogo.
model Carregamento {
  id     Int      @id @default(autoincrement())
  data   DateTime @default(now())
  estado String   @default("ABERTO") // ABERTO | FECHADO
  notas  String?

  veiculoId Int
  veiculo   Veiculo @relation(fields: [veiculoId], references: [id], onDelete: Restrict)

  reboqueId Int?
  reboque   Reboque? @relation(fields: [reboqueId], references: [id], onDelete: SetNull)

  pedidos PedidoPalete[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([veiculoId])
  @@index([reboqueId])
  @@index([data])
}

/// Uma linha de pedido dentro de um carregamento: um cliente pediu N paletes
/// de um tipo. O mesmo cliente pode ter várias linhas (chamadas separadas ao
/// longo do dia). `ordem` fixa a ordem de chegada, usada pelo motor de
/// empacotamento (lib/calc/paletePacking.ts) para simular "quem liga primeiro
/// ocupa primeiro o espaço". Guarda-se mesmo que não caiba fisicamente (o
/// compromisso ao telefone já foi feito) — a UI só assinala o excesso.
model PedidoPalete {
  id         Int    @id @default(autoincrement())
  quantidade Int
  ordem      Int    @default(0)
  /// Orientação forçada das paletes desta linha na planta de carga:
  /// AUTO (motor escolhe) | COMPRIDO (comprimento ao longo do camião) | TRAVES (atravessada)
  orientacao String @default("AUTO")

  carregamentoId Int
  carregamento   Carregamento @relation(fields: [carregamentoId], references: [id], onDelete: Cascade)

  clienteId Int
  cliente   Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  tipoPaleteId Int
  tipoPalete   TipoPalete @relation(fields: [tipoPaleteId], references: [id], onDelete: Restrict)

  criadoEm DateTime @default(now())

  @@index([carregamentoId])
  @@index([clienteId])
  @@index([tipoPaleteId])
}
